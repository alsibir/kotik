---
type Lang = 'ru' | 'en' | 'cs';
const {lang='ru'}=Astro.props as {lang:Lang};
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const pages=[
 {file:'urok_05_komiks_str_01.webp',title:'Спокойное лицо — уверенный голос',alt:'Страница 1. Котик слышит подкол о причёске, сравнивает разные реакции и учится отвечать спокойно.'},
 {file:'urok_05_komiks_str_02.webp',title:'Как выглядит спокойная сила',alt:'Страница 2. Спокойное лицо, ровный голос, уверенная поза, взгляд и последовательность действий.'},
 {file:'urok_05_komiks_str_03.webp',title:'Школьные ситуации',alt:'Страница 3. Шесть школьных ситуаций с примерами спокойных ответов на словесные подколы.'},
 {file:'urok_05_komiks_str_04.webp',title:'Тренировка и миссия',alt:'Страница 4. Упражнения перед зеркалом, тренировка голоса, ролевая игра, проверка себя и правила безопасности.'}
];
const texts={
 ru:{intro:'Оригинальный иллюстрированный комикс к уроку 5. Нажмите на страницу для просмотра в полном размере. Любую страницу можно сохранить отдельно или распечатать весь комикс.',full:'Открыть в полном размере',save:'Скачать изображение',page:'Страница',of:'из'},
 en:{intro:'The original illustrated Russian-language comic for lesson 5. Select a page to view it at full size.',full:'Open full size',save:'Download image',page:'Page',of:'of'},
 cs:{intro:'Původní ilustrovaný komiks k lekci 5 v ruštině. Kliknutím otevřete stránku v plné velikosti.',full:'Otevřít v plné velikosti',save:'Stáhnout obrázek',page:'Strana',of:'z'}
};
const t=texts[lang];
---
<div class="original-comic">
 <p class="original-comic-intro">{t.intro}</p>
 <div class="original-comic-pages">
 {pages.map((page,i)=>{
  const url=base+'/images/shss/lesson-05/'+page.file;
  return <figure class="original-comic-page">
   <a class="original-comic-image-link" href={url} target="_blank" rel="noopener noreferrer" aria-label={t.full+': '+t.page+' '+(i+1)}>
    <img src={url} width="1055" height="1491" alt={page.alt} loading="eager" decoding="async"/>
   </a>
   <figcaption>
    <span>{t.page} {i+1} {t.of} 4 — {page.title}</span>
    <span class="original-comic-actions"><a href={url} target="_blank" rel="noopener noreferrer">{t.full}</a><a href={url} download={page.file}>{t.save}</a></span>
   </figcaption>
  </figure>
 })}
 </div>
</div>
<style>
.original-comic{width:100%;max-width:1055px;margin:0 auto 32px}
.original-comic-intro{font-size:.93rem;color:var(--muted);line-height:1.65}
.original-comic-pages{display:flex;flex-direction:column;align-items:center;gap:30px}
.original-comic-page{width:100%;max-width:1055px;margin:0;background:var(--surface);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);overflow:hidden}
.original-comic-image-link{display:block;line-height:0;background:white}
.original-comic-image-link:focus-visible{outline:4px solid var(--accent);outline-offset:-4px}
.original-comic-image-link img{display:block;width:100%;height:auto;object-fit:contain;aspect-ratio:1055/1491}
.original-comic-page figcaption{padding:13px 17px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:.83rem;color:var(--muted);line-height:1.4}
.original-comic-actions{display:flex;gap:16px;flex-wrap:wrap;align-items:center}
.original-comic-actions a{color:var(--accent);text-decoration:underline;text-underline-offset:3px;font-weight:600}
@media(max-width:720px){.original-comic-pages{gap:16px}.original-comic-page{border-radius:9px}.original-comic-page figcaption{gap:8px;padding:10px 12px;font-size:.78rem}.original-comic-actions{gap:14px}}
@page{size:A4 portrait;margin:7mm}
@media print{
 :global(header),:global(footer),:global(.page-head),:global(.breadcrumb),:global(.shss-tabs),:global(.article-actions),:global(.shss-bottom){display:none!important}
 :global(main){margin:0!important;padding:0!important;min-height:0!important;width:100%!important}
 .original-comic{width:100%;max-width:none;margin:0;padding:0}
 .original-comic-intro{display:none!important}
 .original-comic-pages{display:block!important}
 .original-comic-page{width:100%;max-width:none;margin:0!important;padding:0!important;border:0!important;box-shadow:none!important;border-radius:0!important;overflow:visible;break-inside:avoid;page-break-inside:avoid;break-after:page;page-break-after:always}
 .original-comic-page:last-child{break-after:auto;page-break-after:auto}
 .original-comic-image-link img{display:block;width:100%;max-width:100%;height:auto;max-height:283mm;object-fit:contain}
 .original-comic-page figcaption{display:none!important}
}
</style>
