---
type Lang='ru'|'en'|'cs';
const {lang='ru',lesson=1}=Astro.props as {lang:Lang;lesson:number};
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const titleByLesson:Record<number,string>={
 1:'Что такое спокойная сила',
 2:'Подкол — это не приказ',
 3:'Короткий ответ вместо оправданий',
 4:'Как не втягиваться в провокацию',
 5:'Спокойное лицо — уверенный голос',
 6:'Пауза перед ответом',
 7:'Как закончить неприятный разговор',
 8:'Когда лучше промолчать',
 9:'Моё мнение имеет право быть',
 10:'Как сказать «Не разговаривай со мной так»',
 11:'Как спокойно сказать «нет»',
 12:'Как попросить о помощи',
 13:'Как отличить шутку, конфликт и травлю',
 14:'Как действовать при давлении группы',
 15:'Как поддержать того, кого обижают',
 16:'Безопасность в школьном чате',
 17:'Как рассказать по фактам',
 18:'Как восстановиться после разговора',
 19:'Как слушать и уточнять',
 20:'Как выразить несогласие',
 21:'Как договориться о правилах',
 22:'Как извиниться и исправить',
 23:'Как реагировать на замечания',
 24:'Как уверенно рассказать мысль',
 25:'Как разобрать сложную ситуацию',
 26:"Личный план поддержки",
 27:"Как применить навыки вместе",
 28:"Спокойная сила в действии"
};
const headings:Record<number,string[]>={
 6:['Первая реакция и пауза','Пауза — выдох — решение','Школьные ситуации','Тренинг и безопасность'],
 7:['Завершение неприятного разговора','Полезные фразы','Как закончить разговор','Тренинг и безопасность'],
 8:['Можно не отвечать на подкол','Молчание по выбору и из страха','Ситуации: ответить или промолчать','Тренировка и обращение за помощью'],
 9:['Право на собственное мнение','Мнение, факт и уважение','Школьные примеры несогласия','Тренировка и безопасность'],
 10:['Как обозначить личную границу','Что сказать, если перебивают или берут вещи','Как закончить разговор и обратиться за помощью','Тренировка и безопасность'],
 11:['Короткий отказ','Как помочь, сохранив своё решение','Отказ под давлением','Тренировка короткого отказа'],
 12:['Как начать разговор со взрослым','Что, где и когда случилось','Как обратиться к другому взрослому','Как позвать на помощь сразу'],
 13:['Шутка и право сказать «стоп»','Спор и решение по очереди','Повторяющиеся насмешки','Как выбрать безопасное действие'],
 14:['Как заметить давление', 'Как отказаться участвовать', 'Как уйти и обратиться за помощью', 'Как сохранить право выбора'],
 15:['Как предложить поддержку', 'Как реагировать на обидное сообщение', 'Как предложить пойти вместе', 'Как позвать взрослого при опасности'],
 16:['Личные данные', 'Повторяющиеся насмешки', 'Угроза в сообщении', 'Жалоба и блокировка'],
 17:['Что произошло', 'Приблизительное время', 'Источник сведений', 'Просьба о помощи'],
 18:['Пауза и поддержка', 'Пауза перед ответом в чате', 'Поддержка на перемене', 'Выбор спокойного места'],
 19:['Как выслушать собеседника', 'Время на обдумывание', 'Как принять уточнение', 'Тренировка слушания'],
 20:['Несогласие с предложением', 'Как проверить довод', 'Как завершить разговор при оскорблениях', 'Сравнение двух способов'],
 21:['Очередь в настольной игре', 'Распределение задач', 'Новый участник', 'Проверка правила'],
 22:['Извинение за перебивание', 'Исправление ошибки', 'Сохранение личной границы', 'Исправление подписи'],
 23:['Проверяемое замечание', 'Уточнение замечания', 'Реакция на оскорбление', 'Проверка результата'],
 24:['Мысль, причина и пример', 'Пауза во время выступления', 'Ответ на сложный вопрос', 'Подготовка выступления'],
 25:['Разовая резкость', 'Повторяющееся давление', 'Угроза и безопасный выход', 'Выбор первого действия'],
 26:["Список доверенных взрослых","Запасной взрослый","Поддержка на месте","Хранение личного плана"],
 27:["Предметный спор","Граница и следующий шаг","Безопасный выход","Тренировка выбора действия"],
 28:["Договорённость в команде","Поддержка при повторении травли","Безопасное сопровождение","Итог курса"]
};
const headingsByPage=headings[lesson]||['Школьная ситуация и выбор','Объяснение главного правила','Пять школьных ситуаций','Тренировка и безопасность'];
const pages=Array.from({length:4},(_,i)=>{
 const file='urok_'+String(lesson).padStart(2,'0')+'_komiks_str_'+String(i+1).padStart(2,'0')+'.png';
 return {index:i+1,file,title:headingsByPage[i],url:base+'/images/shss/lesson-'+String(lesson).padStart(2,'0')+'/'+file};
});
---
<div class="comic-series">
 <p class="comic-series-intro">Иллюстрированный комикс «{titleByLesson[lesson]}». Четыре страницы PNG, 1055 × 1491 пиксель. Для просмотра в полном размере нажмите на изображение. Страницы можно сохранять отдельно и распечатывать.</p>
 {pages.map((page,i)=><figure class="comic-sheet">
  <a href={page.url} target="_blank" rel="noopener noreferrer" aria-label={'Открыть страницу '+page.index+' в полном размере'}>
   <img src={page.url} width="1055" height="1491" alt={'Комикс, урок '+lesson+', страница '+page.index+' из 4: '+page.title} loading={i===0?'eager':'lazy'} decoding="async"/>
  </a>
  <figcaption>
   <span><strong>Страница {page.index} из 4.</strong> {page.title}</span>
   <span class="comic-links"><a href={page.url} target="_blank" rel="noopener noreferrer">Полный размер</a><a href={page.url} download={page.file}>Скачать PNG</a></span>
  </figcaption>
 </figure>)}
</div>
<style>
.comic-series{width:100%;max-width:1055px;margin:0 auto 25px;display:flex;flex-direction:column;gap:24px}
.comic-series-intro{color:var(--muted);font-size:.92rem;max-width:900px;line-height:1.65;margin:0 0 3px}
.comic-sheet{margin:0;padding:0;overflow:hidden;border:1px solid var(--line);background:var(--surface);border-radius:14px;box-shadow:var(--shadow)}
.comic-sheet>a{display:block;line-height:0;background:white}
.comic-sheet>a:focus-visible,.comic-links a:focus-visible{outline:3px solid var(--accent);outline-offset:4px}
.comic-sheet img{display:block;width:100%;height:auto;aspect-ratio:1055/1491;object-fit:contain}
.comic-sheet figcaption{padding:14px 19px;display:flex;align-items:center;justify-content:space-between;gap:15px;flex-wrap:wrap;font-size:.83rem;line-height:1.5;color:var(--muted)}
.comic-links{display:flex;gap:17px;align-items:center;flex-wrap:wrap}
.comic-links a{color:var(--accent);font-weight:650;text-underline-offset:3px}
@media(max-width:700px){.comic-series{gap:14px}.comic-sheet{border-radius:8px}.comic-sheet figcaption{padding:11px 13px;font-size:.78rem}}
@page{size:A4 portrait;margin:7mm}
@media print{
 :global(header),:global(footer),:global(.page-head),:global(.breadcrumb),:global(.shss-tabs),:global(.article-actions),:global(.shss-bottom){display:none!important}
 :global(main){margin:0!important;padding:0!important;min-height:0!important;width:100%!important}
 .comic-series{width:100%;max-width:none;display:block;margin:0;padding:0}
 .comic-series-intro,.comic-sheet figcaption{display:none!important}
 .comic-sheet{width:100%;max-width:none;margin:0!important;padding:0!important;border:0!important;box-shadow:none!important;border-radius:0!important;overflow:visible;break-inside:avoid;page-break-inside:avoid;break-after:page;page-break-after:always}
 .comic-sheet:last-child{break-after:auto;page-break-after:auto}
 .comic-sheet img{display:block;width:100%;height:auto;max-width:100%;max-height:282mm;object-fit:contain}
}
</style>
