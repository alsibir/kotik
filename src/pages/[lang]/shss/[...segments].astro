---
import Layout from '../../../layouts/Layout.astro';
import ShssLessonNavigation from '../../../components/ShssLessonNavigation.astro';
import ShssComic from '../../../components/ShssComic.astro';
import ShssComicSeries from '../../../components/ShssComicSeries.astro';
import {marked} from 'marked';
import {languages,type Lang} from '../../../data/ui';
const sourceFiles=import.meta.glob('../../../content/shss/ru/lesson-*.md',{query:'?raw',import:'default',eager:true}) as Record<string,string>;

type Part='text'|'comic'|'test'|'techniques';
type PathEntry={params:{lang:Lang;segments?:string}};
const parts:Part[]=['text','comic','test','techniques'];
const format=(n:number)=>'lesson-'+String(n).padStart(2,'0');
export function getStaticPaths():PathEntry[]{
 const parts:Part[]=['text','comic','test','techniques'];
 const format=(n:number)=>'lesson-'+String(n).padStart(2,'0');
 const result:PathEntry[]=[];
 for(const lang of languages){
  result.push({params:{lang,segments:undefined}});
  for(let n=1;n<=28;n++){
   const slug=format(n);
   result.push({params:{lang,segments:slug}});
   for(const part of parts)result.push({params:{lang,segments:slug+'/'+part}});
  }
 }
 return result;
}
const lang=Astro.params.lang as Lang;
const segments=Astro.params.segments||'';
const [slug,partSlug]=segments.split('/');
const lessonNumber=slug&&/^lesson-(0[1-9]|1\d|2[0-8])$/.test(slug)?Number(slug.slice(7)):null;
const part=partSlug as Part|undefined;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const root=base+'/'+lang+'/shss/';
const link=(p='')=>root+(p?p+'/':'');
const original=(p='')=>base+'/ru/shss/'+(p?p+'/':'');
const route='shss'+(segments?'/'+segments:'');
const i18n={
 ru:{name:'Школа спокойной силы',short:'ШСС',overview:'Программа из 28 уроков',intro:'Курс состоит из 28 уроков, а не из 28 дней. Занятия проходят в удобном темпе. В каждом уроке есть текст, контрольная работа и приёмы словесной борьбы. Для комиксов предусмотрена отдельная вкладка.',lesson:'Урок',ready:'Материал опубликован',draft:'Материал готовится',title5:'Спокойное лицо — уверенный голос',go:'Открыть урок',back:'Все 28 уроков',parts:['Текст урока','Комикс','Контрольная работа','Приёмы СБ'],techniquesTitle:'Приёмы словесной борьбы',summary:'Материалы урока',notice:'Эта страница создана. Учебный материал будет добавлен после подготовки и проверки взрослым наставником.',testNotice:'Отдельная контрольная работа ещё не подготовлена. Краткий блиц-опрос доступен в тексте урока 5.',other:'Все материалы этого урока пока готовятся.',translation:'Перевод этого материала ещё не подготовлен. Оригинал доступен на русском языке.',original:'Открыть русский оригинал',print:'Печатать комикс',safety:'Безопасность важнее спора: при повторяющейся травле или угрозах необходимо обратиться к взрослому.',read:'Читать',open:'Открыть'},
 en:{name:'School of Calm Strength',short:'SCS',overview:'A 28-lesson course',intro:'The course consists of 28 lessons, not 28 days. Lessons can be taken at a comfortable pace. Each lesson has tabs for the text, comic, knowledge check and response techniques.',lesson:'Lesson',ready:'Available',draft:'Coming soon',title5:'Calm face, confident voice',go:'Open lesson',back:'All 28 lessons',parts:['Lesson text','Comic','Knowledge check','Response techniques'],techniquesTitle:'Verbal response techniques',summary:'Lesson materials',notice:'This page has been created. Its content will be added after preparation and adult editorial review.',testNotice:'A separate knowledge check has not yet been prepared.',other:'All materials for this lesson are in preparation.',translation:'The translation of this material is not yet available. The original is in Russian.',original:'Open Russian original',print:'Print comic',safety:'Safety comes first. Seek adult help in case of repeated bullying or threats.',read:'Read',open:'Open'},
 cs:{name:'Škola klidné síly',short:'ŠKS',overview:'Kurz o 28 lekcích',intro:'Kurz tvoří 28 lekcí, nikoli 28 dnů. Tempo si lze zvolit. Každá lekce má záložky pro text, komiks, ověřovací úkol a techniky odpovědí.',lesson:'Lekce',ready:'Zveřejněno',draft:'Připravuje se',title5:'Klidná tvář, jistý hlas',go:'Otevřít lekci',back:'Všech 28 lekcí',parts:['Text lekce','Komiks','Ověření znalostí','Techniky odpovědí'],techniquesTitle:'Techniky slovní obrany',summary:'Materiály lekce',notice:'Stránka je vytvořena. Obsah bude doplněn po přípravě a kontrole dospělým průvodcem.',testNotice:'Samostatné ověření znalostí zatím nebylo připraveno.',other:'Materiály této lekce se připravují.',translation:'Překlad tohoto materiálu zatím není k dispozici. Originál je v ruštině.',original:'Otevřít ruský originál',print:'Tisknout komiks',safety:'Bezpečí má přednost. V případě opakované šikany nebo hrozeb požádej o pomoc dospělého.',read:'Číst',open:'Otevřít'}
};
const t=i18n[lang];
const titles:Record<number,string>={1:'Что такое спокойная сила',2:'Подкол — это не приказ',3:'Короткий ответ вместо оправданий',4:'Как не втягиваться в провокацию',5:'Спокойное лицо — уверенный голос',
 6:'Пауза перед ответом',
 7:'Как закончить неприятный разговор',
 8:'Когда лучше промолчать',
 9:'Моё мнение имеет право быть',
 10:'Как сказать «Не разговаривай со мной так»',
 11:'Как спокойно сказать «нет»',
 12:'Как попросить о помощи',
 13:'Как отличить шутку, конфликт и травлю',
 14:'Как действовать при давлении группы',
 15:'Как поддержать того, кого обижают',
 16:'Как защитить себя в школьном чате',
 17:'Как рассказать о случившемся по фактам',
 18:'Как восстановиться после неприятного разговора',
 19:'Как слушать и уточнять',
 20:'Как выразить несогласие с доводом',
 21:'Как договориться о справедливых правилах',
 22:'Как извиниться и исправить ошибку',
 23:'Как реагировать на замечания',
 24:'Как уверенно рассказать свою мысль',
 25:'Как разбирать сложную ситуацию',
 26:'Как составить личный план поддержки',
 27:'Как применять навыки вместе',
 28:'Итоговый урок. Спокойная сила в действии',
};
const contentFor=(n:number,section:Exclude<Part,'comic'>)=>sourceFiles['../../../content/shss/ru/lesson-'+String(n).padStart(2,'0')+(section==='text'?'':'-'+section)+'.md'];
const hasMaterial=(n:number,p:Part)=>p==='comic'?n<=13:Boolean(contentFor(n,p));
const ready=(n:number,p:Part)=>lang==='ru'&&hasMaterial(n,p);
const hasTextAndTest=(n:number)=>ready(n,'text')&&ready(n,'test');
const material=lessonNumber!==null&&part&&part!=='comic'&&ready(lessonNumber,part)
 ? contentFor(lessonNumber,part)
 : undefined;
const title=lessonNumber===null?t.name:t.lesson+' '+lessonNumber+(lang==='ru'?' — '+titles[lessonNumber]:lessonNumber===5?' — '+t.title5:'');
const sectionTitle=part==='techniques'?t.techniquesTitle:part?t.parts[parts.indexOf(part)]:undefined;
const pageTitle=sectionTitle?sectionTitle+' — '+title:title;
const numberId=lessonNumber===null?'':format(lessonNumber);
const lessonNavigation={ru:'Переход между уроками',en:'Lesson navigation',cs:'Přechod mezi lekcemi'}[lang];
const lessonLink=(n:number)=>link(format(n)+(part?'/'+part:''));
const fullOriginal=original(numberId+(part?'/'+part:''));
---
<Layout lang={lang} title={pageTitle} route={route} description={t.intro}>
 {lessonNumber===null?
 <>
  <div class="page-head"><div class="eyebrow">{t.short} · 28</div><h1>{t.name}</h1><p>{t.intro}{lang==='ru'&&<><br /><small>Начальный уровень · от 11 лет</small></>}</p></div>
  <div class="shss-summary"><strong>{t.overview}</strong><span>{t.safety}</span></div>
  <div class="shss-lessons">
   {Array.from({length:28},(_,i)=>i+1).map(n=>
    <a class={'shss-lesson'+(hasTextAndTest(n)?' shss-featured':'')} href={link(format(n))}>
     <span class="shss-index">{String(n).padStart(2,'0')}</span>
     <span class="shss-card-title">{t.lesson} {n}{lang==='ru'&&<small>{titles[n]}</small>}</span>
     <span class={'shss-status'+(ready(n,'comic')?' shss-status-ready':'')}>{ready(n,'comic')?t.ready:hasTextAndTest(n)?'Текст и контрольная работа доступны':t.draft}</span>
     <span aria-hidden="true" class="shss-arrow">→</span>
    </a>)}
  </div>
 </> :
 <>
 <div class="page-head">
  <div class="breadcrumb"><a href={link()}>{t.back}</a> / <a href={link(numberId)}>{t.lesson} {lessonNumber}</a>{part&&<> / {t.parts[parts.indexOf(part)]}</>}</div>
  <div class="eyebrow">{t.short} · {t.lesson} {String(lessonNumber).padStart(2,'0')} / 28</div>
  <h1>{sectionTitle??title}</h1>
  <p>{lang==='ru'&&titles[lessonNumber]?titles[lessonNumber]:t.other}</p>
 </div>
 {!part?
  <>
   <div class="shss-parts">
    {parts.map((p,i)=>
     <a class="shss-part" href={link(numberId+'/'+p)}>
      <span class="shss-index">0{i+1}</span>
      <h2>{t.parts[i]}</h2>
      <span class={'shss-status'+(ready(lessonNumber,p)?' shss-status-ready':'')}>{ready(lessonNumber,p)?t.ready:t.draft}</span>
      <span class="shss-open">{t.open} →</span>
     </a>)}
   </div>
   <ShssLessonNavigation lessonNumber={lessonNumber} label={lessonNavigation} lessonLabel={t.lesson} sectionTitle={sectionTitle} lessonLink={lessonLink} />
   <p class="shss-notice">{lessonNumber<=9&&lang==='ru'?'Полный комплект: текст урока, четырёхстраничный комикс, контрольная работа и практический тренинг.':hasTextAndTest(lessonNumber)?'Текст урока и контрольная работа с тренингом опубликованы. Полноразмерный комикс по этой теме ещё готовится.':t.notice}</p>
  </> :
  <>
   <div class="shss-tabs" aria-label={t.summary}>
    {parts.map((p,i)=><a href={link(numberId+'/'+p)} aria-current={part===p?'page':undefined}>{t.parts[i]}</a>)}
   </div>
   <ShssLessonNavigation lessonNumber={lessonNumber} label={lessonNavigation} lessonLabel={t.lesson} sectionTitle={sectionTitle} lessonLink={lessonLink} />
   {material&&part==='techniques'&&
    <article class="prose shss-text shss-techniques">
     <p><strong>Котик, выучи эти фразы наизусть.</strong> Повторяй их вслух, пока нужный ответ не начнёт вспоминаться и произноситься сам, без долгих раздумий. Если даны варианты одной фразы, начни с того, который тебе проще произнести. В заготовках с многоточием подставляй слова по ситуации.</p>
     <p>Попроси Команду спокойной силы задавать вопросы из последней колонки вразнобой. Закрой колонку с ответами, выбери фразу или действие и объясни свой выбор. Затем сверься с таблицей и повтори ответ обычным голосом.</p>
     <p>При повторяющейся травле обратись к доверенному взрослому. При угрозе зови на помощь сразу и переходи в безопасное место при первой возможности.</p>
     <div class="shss-table-scroll" role="region" aria-label="Таблица приёмов словесной борьбы" tabindex="0" set:html={marked.parse(material)} />
    </article>}
   {material&&part!=='techniques'&&<article class="prose shss-text" set:html={marked.parse(material)} />}
   {part==='comic'&&ready(lessonNumber,part)&&
    <><div class="article-actions"><button class="print" data-print>{t.print}</button></div>{lessonNumber===5?<ShssComic lang={lang}/>:<ShssComicSeries lang={lang} lesson={lessonNumber}/>}</>}
   {!ready(lessonNumber,part)&&
    <div class="shss-notice">
     <p>{hasMaterial(lessonNumber,part)?t.translation:part==='comic'&&hasTextAndTest(lessonNumber)?'Комикс готовится. Текст урока и контрольная работа доступны.':t.notice}</p>
     {hasMaterial(lessonNumber,part)&&<a class="button" href={fullOriginal}>{t.original} →</a>}
    </div>}
   <ShssLessonNavigation lessonNumber={lessonNumber} label={lessonNavigation} lessonLabel={t.lesson} sectionTitle={sectionTitle} lessonLink={lessonLink} />
   <div class="shss-bottom"><a class="button" href={link(numberId)}>{t.summary} →</a><a class="button" href={link()}>{t.back} →</a></div>
  </>}
 </>
 }
</Layout>
<style>
.shss-summary{display:flex;justify-content:space-between;align-items:center;gap:24px;border-radius:14px;background:var(--soft);padding:22px;margin:0 0 26px}
.shss-summary strong{font-size:1.1rem}.shss-summary span{max-width:560px;color:var(--muted);font-size:.9rem}
.shss-lessons{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
.shss-lesson,.shss-part{display:flex;flex-direction:column;gap:10px;min-width:0;text-decoration:none;background:var(--surface);border:1px solid var(--line);border-radius:15px;padding:20px;box-shadow:var(--shadow)}
.shss-lesson:hover,.shss-part:hover{border-color:var(--accent)}
.shss-featured{border-color:var(--accent);background:var(--soft)}
.shss-index{color:var(--accent);font-weight:800;font-size:1.5rem;line-height:1}
.shss-card-title{font-weight:700;line-height:1.35;font-size:1.07rem;min-height:57px}
.shss-card-title small{display:block;color:var(--muted);font-size:.82rem;font-weight:500;margin-top:5px}
.shss-status{color:var(--muted);font-size:.78rem;line-height:1.3;margin-top:auto}
.shss-status-ready{color:var(--accent);font-weight:700}
.shss-arrow,.shss-open{font-size:.83rem;color:var(--accent);align-self:flex-end}
.shss-parts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
.shss-part{min-height:190px;padding:25px}.shss-part h2{font-size:1.4rem;margin:10px 0 5px}
.shss-notice{max-width:840px;margin:30px 0;border:1px dashed var(--line);border-radius:14px;padding:26px;color:var(--muted);background:var(--surface)}
.shss-notice p{margin-bottom:14px}.shss-notice p:last-child{margin-bottom:0}
.shss-tabs{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 24px}
.shss-tabs a{background:var(--surface);padding:9px 16px;border:1px solid var(--line);border-radius:12px;text-decoration:none;font-size:.9rem}
.shss-tabs a[aria-current=page]{border-color:var(--accent);background:var(--soft);font-weight:700}
.shss-text{max-width:880px;background:var(--surface);border:1px solid var(--line);padding:clamp(18px,4vw,48px);border-radius:15px}
.shss-text :global(h1){font-size:clamp(1.8rem,3.4vw,2.6rem)}
.shss-text :global(h2){font-size:1.5rem;margin-top:35px}
.shss-text :global(h3){font-size:1.17rem;margin-top:23px}
.shss-text :global(p){line-height:1.75}
.shss-text :global(li){margin-bottom:9px}.shss-text :global(details){border:1px solid var(--line);padding:17px;border-radius:12px;margin-top:25px;background:var(--soft)}.shss-text :global(summary){cursor:pointer;font-weight:700;color:var(--accent)}
.shss-techniques{max-width:none}
.shss-table-scroll{overflow-x:auto;margin-top:24px}
.shss-table-scroll:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
.shss-table-scroll :global(table){width:100%;min-width:660px;border-collapse:collapse;font-size:.95rem;line-height:1.5}
.shss-table-scroll :global(th),.shss-table-scroll :global(td){border:1px solid var(--line);padding:12px;text-align:left;vertical-align:top}
.shss-table-scroll :global(th){background:var(--soft)}
.shss-table-scroll :global(td:first-child){width:26%}
.shss-bottom{display:flex;gap:12px;margin:34px 0;flex-wrap:wrap}
@media(max-width:900px){.shss-lessons{grid-template-columns:repeat(3,1fr)}.shss-parts{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:720px){.shss-lessons{grid-template-columns:repeat(2,minmax(0,1fr))}.shss-parts{grid-template-columns:1fr}.shss-summary{display:block}.shss-summary strong{display:block;margin-bottom:10px}.shss-lesson{padding:15px}.shss-card-title{min-height:50px}}
@media(max-width:400px){.shss-lessons{gap:9px}.shss-lesson{padding:12px}.shss-card-title{font-size:.95rem}}
@media print{.shss-tabs,.shss-bottom,.article-actions{display:none}.shss-text{border:0;padding:0;max-width:none}.shss-lesson,.shss-part{box-shadow:none;break-inside:avoid}}
</style>
