---
import SocialCard from "../components/SocialCard.astro";
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta http-equiv="refresh" content={`0;url=${base}/ru/`}/><title>Котик — школа спокойной силы</title><SocialCard title="Котик — школа спокойной силы" description="28 уроков, комиксы и практика спокойного общения." url={new URL(`${base}/`, Astro.site)}/></head><body><a href={`${base}/ru/`}>Русский</a> · <a href={`${base}/en/`}>English</a> · <a href={`${base}/cs/`}>Čeština</a></body></html>
